# ===== Twitch (обязательно) =====
# Client ID и Secret приложения — https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# User access token бота (БЕЗ префикса «oauth:») и refresh token.
# Получить: python scripts/get_token.py (см. README, раздел «Токены»).
TWITCH_BOT_TOKEN=
TWITCH_BOT_REFRESH=

# Числовой ID аккаунта бота (не ник!). Узнать после get_token.py или через API.
TWITCH_BOT_ID=

# Имя канала и ник бота (логин, не отображаемое имя)
TWITCH_CHANNEL=kokocabpukoc
TWITCH_BOT_NICK=lunax2000

# ===== Groq AI (обязательно) =====
GROQ_API_KEY=

# ===== Настройки AI =====
GROQ_MODEL=openai/gpt-oss-20b
AI_TEMPERATURE=0.8
MAX_TOKENS=250
AI_TIMEOUT=30
MAX_HISTORY=15

# ===== Поведение бота =====
BOT_PREFIX=!
USER_COOLDOWN=15
GLOBAL_COOLDOWN=3
DB_PATH=luna.db
LOG_LEVEL=INFO

# Доп. админы (логины через запятую), которые могут модерировать без бейджа модератора
ADMIN_NICKS=

# ===== Только для get_token.py =====
TWITCH_REDIRECT_URI=http://localhost:3000